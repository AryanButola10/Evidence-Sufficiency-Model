# ===========================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Never commit .env to git
# ===========================================================

# -----------------------------------------------------------
# LLM Provider
# Options: "ollama" | "groq"
# -----------------------------------------------------------
LLM_PROVIDER=ollama

# -----------------------------------------------------------
# Ollama Configuration (used when LLM_PROVIDER=ollama)
# Install Ollama: https://ollama.ai
# After installing, pull models:
#   ollama pull llama3.2:3b       # dev model (~2 GB)
#   ollama pull llama3.1:8b       # eval model (~5 GB)
# -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEV_MODEL=llama3.2:3b
OLLAMA_EVAL_MODEL=llama3.1:8b

# -----------------------------------------------------------
# Groq API Configuration (used when LLM_PROVIDER=groq)
# Get a free key at: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------
# FastAPI Backend
# -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# -----------------------------------------------------------
# CORS (Next.js frontend origin)
# -----------------------------------------------------------
# IMPORTANT: Must be a JSON array — pydantic-settings v2 requires this for list fields
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------
# Qdrant Vector Database
# Phase 1-2: in-memory (no config needed)
# Phase 3+:  set USE_PERSISTENT_QDRANT=true + configure below
# -----------------------------------------------------------
USE_PERSISTENT_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=reliability_rag

# -----------------------------------------------------------
# PostgreSQL (Phase 3+)
# -----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reliability_rag
POSTGRES_USER=raguser
POSTGRES_PASSWORD=your_secure_password_here

# -----------------------------------------------------------
# Embedding Model (BGE-M3)
# Phase 2+: will be downloaded automatically on first run (~1.1 GB)
# -----------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=mps

# -----------------------------------------------------------
# Reranker Model
# Phase 3+: downloaded automatically on first run (~0.5 GB)
# -----------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=mps

# -----------------------------------------------------------
# NLI Model (DeBERTa-v3 for entailment/contradiction)
# Phase 4+: downloaded automatically on first run (~0.7 GB)
# -----------------------------------------------------------
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_DEVICE=mps

# -----------------------------------------------------------
# Evidence Sufficiency Model Thresholds
# Phase 5+: adjust based on experimental results
# -----------------------------------------------------------
ESM_UPPER_THRESHOLD=0.65
ESM_LOWER_THRESHOLD=0.35
ESM_MAX_RETRIEVAL_ITERATIONS=3

# -----------------------------------------------------------
# Logging
# -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# -----------------------------------------------------------
# MLflow Experiment Tracking (Phase 10)
# -----------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=reliability_rag
